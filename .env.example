# ==== Telegram (required) ====
# Create a bot with @BotFather -> copy the token here
TELEGRAM_BOT_TOKEN=
# Target group/channel. Examples:
#   Public channel/group:  @my_jobs_channel
#   Private group/channel: -1001234567890
TELEGRAM_CHAT_ID=
# Only this user (or someone passing user=<name>) may run /latest
LATEST_USER=aka_bala

# ==== Job sources ====
# Adzuna (recommended, needs free key): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Role queries run against Adzuna (one request each).
# Keep this SHORT: hits/day = queries x polls/day must stay < 250 on free tier.
ADZUNA_QUERIES=full stack developer,devops engineer,technical support engineer,data analyst,customer support executive,machine learning engineer

# ==== Filtering ====
# Comma-separated keywords matched against title/company
KEYWORDS=react,node,node.js,full stack,fullstack,javascript,typescript,frontend,backend,flutter,fresher,junior,trainee,entry level,intern
# These count as fresher/junior words; they only match a tech role
LEVEL_KEYWORDS=fresher,junior,trainee,entry level,intern
LOCATION=India
# Jobs must pay MORE than this (strict). 0 disables the salary filter.
MIN_SALARY=0
# Include listings with no salary (true) or drop them (false)
INCLUDE_UNKNOWN_SALARY=true
# Also match keywords in the description (true) or title/company only (false)
MATCH_DESCRIPTION=false
# 0 = search all KEYWORDS on Himalayas; N = only the first N
HIMALAYAS_MAX_KEYWORDS=0
# Any title containing these words is skipped
SENIORITY_BLOCKLIST=senior,sr,staff,lead,architect,principal,manager,director,head,vp
# Allowed employment types (others are skipped). Empty = allow all
TYPE_ALLOWLIST=full-time,part-time,contract,intern
# Only keep jobs whose location mentions India
INDIA_ONLY=false
# Optional Himalayas experience filter: entry-level | mid-level | senior | ...
EXPERIENCE_LEVEL=

# ==== Role routing (multi-group mode) ====
# JSON map role -> Telegram chat. Non-empty enables fetch-once, route-locally
# fan-out. Empty = legacy single-chat mode using TELEGRAM_CHAT_ID.
ROLE_GROUPS={"fullstack":"@full_stack_aka_bala","devops":"@devops_aka_bala","tech-support":"@tech_support_aka_bala","analyst":"@analyst_aka_bala","ai-ml":"@ai_ml_channel"}
# Per-role keyword overrides (comma-separated, title/company match).
# Defaults cover the 5 roles; uncomment to customize.
# (An override REPLACES the default list for that role — include full list.)
#ROLE_FULLSTACK_KEYWORDS=full stack,fullstack,mern,frontend,backend,react,node,javascript,typescript
#ROLE_DEVOPS_KEYWORDS=devops,sre,platform engineer,kubernetes,docker,terraform,aws,ci/cd
#ROLE_TECH_SUPPORT_KEYWORDS=technical support,it support,helpdesk,voice process,bpo,chat support
#ROLE_ANALYST_KEYWORDS=data analyst,business analyst,power bi,tableau,sql analyst,mis executive
#ROLE_AI_ML_KEYWORDS=machine learning,ml engineer,data scientist,deep learning,nlp,llm

# ==== Enrichment ====
# Fetch full details (real salary + JD) for unknown-salary Himalayas jobs
ENRICH_DETAILS=true
ENRICH_MAX_PER_RUN=6
# Characters of the JD snippet shown in each message
JD_SNIPPET_CHARS=220

# ==== Behaviour ====
# How often to check for new jobs (minutes)
POLL_INTERVAL_MINUTES=30
# Max new jobs queued per run (avoids spam)
MAX_JOBS_PER_RUN=8
# Max new jobs queued per role per run (multi-group mode)
MAX_PER_ROLE=4
# Share of each batch reserved for fresher/junior roles (0..1)
FRESHER_SHARE=0.5
# Gap between two Telegram messages (ms) to avoid flood limits
MESSAGE_DELAY_MS=2500
# Failed send attempts before a job is dropped
MAX_SEND_RETRIES=3
DATA_FILE=./data/seen.json
QUEUE_FILE=./data/queue.json

# ==== Optional HTTP trigger (for curl) ====
# 0 disables the HTTP server. Bound to localhost by default.
TRIGGER_PORT=0
TRIGGER_HOST=127.0.0.1
# If set, requests must also pass ?token=<value> (useful if binding 0.0.0.0)
TRIGGER_TOKEN=
